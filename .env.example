# Copie para .env e preencha. O .env nunca vai para o git.

# --- IA (console.anthropic.com -> Settings -> API Keys) ---
ANTHROPIC_API_KEY=
MODELO_BOT=claude-haiku-4-5

# --- Banco (Supabase -> Connect -> Connection string; preencher depois) ---
DATABASE_URL=

# --- TACO sem banco (testes locais) ---
TACO_JSON=dados/taco.json

# --- WhatsApp via uazapi (painel da uazapi -> instância) ---
UAZAPI_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=
# segredo que vai no caminho da URL do webhook (gere com: python -c "import secrets; print(secrets.token_urlsafe(24))")
WEBHOOK_SEGREDO=

# --- WhatsApp / Meta Cloud API (alternativa oficial; não usado agora) ---
WHATSAPP_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# Link do termo de consentimento (LGPD) enviado ao paciente antes da 1ª conversa
TERMO_URL=

# Rotinas automáticas (lembrete 24 h, retorno, resumo das 8h). off desliga.
ROTINAS=on
# Número que não é paciente é atendido pelo bot comercial (off = fica sem resposta)
COMERCIAL=on

# eco = só devolve a mensagem (teste do webhook); bot = responde com a IA
MODO=eco

# --- Google Agenda (conta de serviço seu-servico@seu-projeto.iam.gserviceaccount.com) ---
# JSON da chave em base64. A agenda de cada nutri fica em nutricionistas.google_calendar_id.
GOOGLE_SERVICE_ACCOUNT_B64=
# só para scripts locais de teste (agenda "Nutri – teste")
GOOGLE_CALENDAR_ID=
# Painel da nutri (/painel/<token>): segredo que assina os links (32+ caracteres; vazio = painel desligado).
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(36))"   Trocar invalida todos os links.
PAINEL_SEGREDO=
# Endereço público do app para montar o link. No Railway fica vazio: usa RAILWAY_PUBLIC_DOMAIN.
URL_PUBLICA=
# LGPD: dias até apagar mensagens de pacientes / de leads (mínimos 30 e 7). Prazos a confirmar.
RETENCAO_DIAS=180
RETENCAO_LEADS_DIAS=90
# Alerta quando o WhatsApp cai (ntfy: https://ntfy.sh/<tópico-difícil>; ou webhook do Discord/Slack)
ALERTA_URL=
# Modelo que lê PDF/foto do plano (uma chamada por plano)
MODELO_IMPORTACAO=claude-sonnet-5-5

# Sugestão de resposta pesquisada no aviso de encaminhamento (bot/rascunho.py): on | off
RASCUNHO=on
# MODELO_RASCUNHO=claude-sonnet-5-5
